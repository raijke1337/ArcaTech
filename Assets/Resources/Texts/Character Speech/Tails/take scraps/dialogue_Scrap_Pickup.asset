  DialogueContents:
  - Text: Nyaice!
    VoiceLine: {fileID: 11400000, guid: b39b682cb39b6e3419179e6b5d5d2078, type: 2}
  - Text: More for the collection.
    VoiceLine: {fileID: 11400000, guid: 19d02acdd5fbc57409a3ad583b8445e0, type: 2}
  - Text: Shiny! Mine meow.
    VoiceLine: {fileID: 11400000, guid: 7d5e1cd9d6d4743469ce99291e65f4fd, type: 2}
